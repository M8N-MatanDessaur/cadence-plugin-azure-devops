{
  "id": "azure-devops",
  "name": "Azure DevOps",
  "version": "0.7.1",
  "sdkVersion": 3,
  "description": "Azure DevOps: work items, iterations, teams, velocity, areas, activity, AB# auto-linking",
  "icon": "kanban",
  "tint": "0, 120, 215",
  "instructions": "instructions.md",
  "aiKeywords": [
    "azure devops",
    "ado",
    "work item",
    "workitems",
    "backlog",
    "sprint",
    "iteration",
    "velocity",
    "burndown",
    "team capacity",
    "team",
    "area path",
    "user story",
    "bug",
    "task",
    "feature",
    "epic",
    "standup",
    "retro",
    "retrospective",
    "AB#",
    "ab-reference",
    "pipeline",
    "pipelines",
    "build",
    "deploy",
    "release",
    "release notes",
    "changelog",
    "CI/CD",
    "pipeline health"
  ],
  "activationConditions": {
    "configKeys": [
      "AzureDevOpsOrg",
      "AzureDevOpsProject",
      "AzureDevOpsPAT"
    ]
  },
  "settings": [],
  "contributions": {
    "routes": "routes.js",
    "configKeys": [
      "AzureDevOpsOrg",
      "AzureDevOpsProject",
      "AzureDevOpsProjects",
      "AzureDevOpsPAT",
      "DefaultTeam",
      "DefaultArea"
    ],
    "sensitiveKeys": [
      "AzureDevOpsPAT"
    ],
    "imageAuth": [
      {
        "hostnamePattern": "dev.azure.com",
        "authType": "basic-pat",
        "authConfigKey": "AzureDevOpsPAT"
      },
      {
        "hostnamePattern": "visualstudio.com",
        "authType": "basic-pat",
        "authConfigKey": "AzureDevOpsPAT"
      }
    ],
    "nativeSettings": {
      "targetId": "settingsTab-ado"
    },
    "centerTabs": [
      {
        "id": "backlog",
        "label": "Backlog",
        "icon": "list-todo",
        "pinned": true,
        "position": 2,
        "claims": {
          "tabBtnId": "backlogTabBtn",
          "panelId": "panel-backlog"
        },
        "openable": true
      },
      {
        "id": "workitem",
        "label": "Work Item",
        "icon": "ticket",
        "popup": true,
        "position": 3,
        "claims": {
          "tabBtnId": "workitemTabBtn",
          "panelId": "panel-workitem"
        }
      },
      {
        "id": "activity",
        "label": "Activity Timeline",
        "icon": "activity",
        "popup": true,
        "position": 5,
        "claims": {
          "tabBtnId": "activityTabBtn",
          "panelId": "panel-activity"
        }
      }
    ],
    "leftQuickActions": [
      {
        "id": "ado-new-item",
        "label": "New Work Item",
        "icon": "plus",
        "command": "openCreateModal"
      },
      {
        "id": "ado-my-items",
        "label": "My Items",
        "icon": "user",
        "command": "filterMyItems"
      }
    ],
    "aiActions": [
      {
        "id": "standup-summary",
        "label": "Standup Summary",
        "icon": "message-square",
        "requires": [
          "sprint"
        ],
        "script": "scripts/Get-StandupSummary.ps1",
        "args": "-IterationPath '${sprint}'",
        "analyze": "give me a brief analysis of the standup for \"${sprintName}\". What should we focus on today?"
      },
      {
        "id": "iteration-status",
        "label": "Iteration Status",
        "icon": "bar-chart-2",
        "requires": [
          "sprint"
        ],
        "script": "scripts/Get-SprintStatus.ps1",
        "analyze": "analyze the results. Are we on track for \"${sprintName}\"? Any concerns?"
      },
      {
        "id": "retrospective",
        "label": "Retrospective",
        "icon": "rotate-ccw",
        "script": "scripts/Get-Retrospective.ps1",
        "analyze": "give me a retrospective analysis. What went well? What can we improve?"
      }
    ],
    "commitLinkers": [
      {
        "id": "ab-ref",
        "pattern": "AB#(\\d+)",
        "urlTemplate": "{adoOrgUrl}/_workitems/edit/{1}",
        "note": "Auto-links AB#<id> in commit messages and branch names to the corresponding ADO work item"
      }
    ],
    "workItemProvider": {
      "id": "azure-devops",
      "label": "Azure DevOps",
      "listRoute": "/api/workitems",
      "createRoute": "/api/workitems/create",
      "getRoute": "/api/workitems/:id",
      "updateStateRoute": "/api/workitems/:id/state",
      "commentRoute": "/api/workitems/:id/comments",
      "iterationsRoute": "/api/iterations",
      "teamsRoute": "/api/teams",
      "teamMembersRoute": "/api/team-members",
      "areasRoute": "/api/areas",
      "velocityRoute": "/api/velocity",
      "burndownRoute": "/api/burndown",
      "startWorkingRoute": "/api/start-working"
    },
    "mcp": {
      "tools": [
        {
          "name": "list_work_items",
          "description": "List Azure DevOps work items. Returns id, title, state, assignedTo, type, and storyPoints.",
          "route": "GET /api/workitems",
          "inputSchema": {
            "type": "object",
            "properties": {
              "iteration": {
                "type": "string",
                "description": "Iteration path."
              },
              "state": {
                "type": "string",
                "description": "Filter by state."
              },
              "refresh": {
                "type": "boolean",
                "description": "Force refresh the cache."
              }
            }
          }
        },
        {
          "name": "get_work_item",
          "description": "Get full details of a single Azure DevOps work item by id.",
          "route": "GET /api/workitems/:id",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "description": "Work item id."
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "name": "create_work_item",
          "description": "Create an Azure DevOps work item. Gated by permissions.",
          "route": "POST /api/workitems/create",
          "bodyFrom": "arguments",
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "User Story",
                  "Bug",
                  "Task",
                  "Feature",
                  "Epic"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "priority": {
                "type": "number",
                "enum": [
                  1,
                  2,
                  3,
                  4
                ],
                "default": 2
              },
              "storyPoints": {
                "type": "number"
              },
              "iterationPath": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "title"
            ]
          }
        },
        {
          "name": "set_work_item_state",
          "description": "Change the state of a work item. Gated by permissions.",
          "route": "PATCH /api/workitems/:id/state",
          "bodyFrom": "arguments",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "state": {
                "type": "string",
                "enum": [
                  "New",
                  "Active",
                  "Resolved",
                  "Closed",
                  "Removed"
                ]
              }
            },
            "required": [
              "id",
              "state"
            ]
          }
        }
      ],
      "prompts": [
        {
          "name": "standup_summary",
          "description": "Generate a daily standup summary from recent work item activity.",
          "route": "GET /api/workitems"
        },
        {
          "name": "retro_analysis",
          "description": "Generate a sprint retrospective starter from work items.",
          "route": "GET /api/workitems"
        }
      ]
    },
    "rightTabs": [
      {
        "id": "activity",
        "label": "Activity",
        "pinned": true,
        "position": 0,
        "claims": {
          "tabBtnId": "intelTab-activity",
          "panelId": "ipanel-activity"
        }
      },
      {
        "id": "team",
        "label": "Team",
        "pinned": true,
        "position": 1,
        "claims": {
          "tabBtnId": "intelTab-team",
          "panelId": "ipanel-team"
        }
      }
    ],
    "surfaces": [
      {
        "id": "ado",
        "title": "Azure DevOps",
        "icon": "kanban",
        "mount": "rail",
        "entry": "ui/ado.js",
        "sidebar": true,
        "aside": true
      }
    ],
    "scripts": [
      {
        "file": "Get-Activity.ps1",
        "label": "What moved recently",
        "description": "The project timeline: who changed what, when, and its state now.",
        "args": [
          {
            "name": "Days",
            "label": "Days back",
            "default": "7"
          },
          {
            "name": "Person",
            "label": "Only this person",
            "required": false
          }
        ]
      },
      {
        "file": "Get-PersonLoad.ps1",
        "label": "What someone is carrying",
        "description": "Everything open and assigned to one person, plus what they finished lately.",
        "args": [
          {
            "name": "Who",
            "label": "Display name",
            "required": true
          },
          {
            "name": "Days",
            "label": "Days back",
            "default": "30"
          }
        ]
      },
      {
        "file": "Get-MyWorkItems.ps1",
        "label": "My work items",
        "description": "What is assigned to you in the current sprint, grouped by state.",
        "args": [
          {
            "name": "State",
            "label": "Only this state",
            "required": false
          }
        ]
      },
      {
        "file": "Get-SprintStatus.ps1",
        "label": "Sprint status",
        "description": "Where the current sprint stands."
      },
      {
        "file": "Get-StandupSummary.ps1",
        "label": "Standup summary",
        "description": "A standup you can paste, built from what actually changed.",
        "args": [
          {
            "name": "IterationPath",
            "label": "Sprint path",
            "required": false
          }
        ]
      },
      {
        "file": "Get-Retrospective.ps1",
        "label": "Retrospective",
        "description": "What landed, what slipped, and what to say about it."
      },
      {
        "file": "Find-WorkItems.ps1",
        "label": "Find work items",
        "description": "Search by text, type, state, assignee or sprint.",
        "args": [
          {
            "name": "Search",
            "label": "Text",
            "required": false
          },
          {
            "name": "Type",
            "label": "Type",
            "required": false
          },
          {
            "name": "State",
            "label": "State",
            "required": false
          },
          {
            "name": "AssignedTo",
            "label": "Assigned to",
            "required": false
          }
        ]
      },
      {
        "file": "Get-WorkItem.ps1",
        "label": "Open one work item",
        "description": "The full detail of a single item.",
        "args": [
          {
            "name": "Id",
            "label": "Work item number",
            "required": true
          }
        ]
      },
      {
        "file": "New-WorkItem.ps1",
        "label": "Create a work item",
        "description": "Create a task, bug, story or feature.",
        "mutates": true,
        "args": [
          {
            "name": "Type",
            "label": "Type",
            "default": "Task"
          },
          {
            "name": "Title",
            "label": "Title",
            "required": true
          },
          {
            "name": "Description",
            "label": "Description",
            "required": false
          },
          {
            "name": "AssignedTo",
            "label": "Assign to",
            "required": false
          },
          {
            "name": "Tags",
            "label": "Tags",
            "required": false
          }
        ]
      },
      {
        "file": "Set-WorkItemState.ps1",
        "label": "Change a state",
        "description": "Move one item to another state.",
        "mutates": true,
        "args": [
          {
            "name": "Id",
            "label": "Work item number",
            "required": true
          },
          {
            "name": "State",
            "label": "New state",
            "required": true
          }
        ]
      },
      {
        "file": "Add-WorkItemComment.ps1",
        "label": "Comment on a work item",
        "description": "Leave a note on an item without opening a browser.",
        "mutates": true,
        "args": [
          {
            "name": "Id",
            "label": "Work item number",
            "required": true
          },
          {
            "name": "Text",
            "label": "Comment",
            "required": true
          }
        ]
      },
      {
        "file": "Refresh-Board.ps1",
        "label": "Refresh the board",
        "description": "Drop the cached board data and read it again.",
        "mutates": true
      },
      {
        "file": "Get-Pipelines.ps1",
        "label": "List pipelines",
        "description": "Every pipeline with its latest run.",
        "args": []
      },
      {
        "file": "Get-PipelineRuns.ps1",
        "label": "Runs of a pipeline",
        "description": "Newest first, optionally one branch.",
        "args": [
          {
            "name": "Id",
            "label": "Pipeline id"
          },
          {
            "name": "Top",
            "label": "How many",
            "default": "30"
          }
        ]
      },
      {
        "file": "Get-PipelineRun.ps1",
        "label": "Read a run",
        "description": "Stages, failed tasks with logs, commits and work items of one run.",
        "args": [
          {
            "name": "Id",
            "label": "Run (build) id"
          }
        ]
      },
      {
        "file": "Get-PipelineHealth.ps1",
        "label": "Pipeline health",
        "description": "Success rate, failures, duration, trend.",
        "args": [
          {
            "name": "Id",
            "label": "Pipeline id"
          }
        ]
      },
      {
        "file": "New-ReleaseNotes.ps1",
        "label": "Release notes",
        "description": "Between two runs, from the linked work items and commits.",
        "args": [
          {
            "name": "Id",
            "label": "Pipeline id"
          },
          {
            "name": "To",
            "label": "Run id shipped"
          },
          {
            "name": "From",
            "label": "Previous run id",
            "default": ""
          }
        ]
      },
      {
        "file": "Get-UnreleasedItems.ps1",
        "label": "Waiting to ship",
        "description": "Resolved or closed since the last successful run.",
        "args": [
          {
            "name": "Id",
            "label": "Pipeline id",
            "default": ""
          }
        ]
      },
      {
        "file": "Start-Pipeline.ps1",
        "label": "Queue a run",
        "description": "Runs a pipeline, on a branch if given.",
        "mutates": true,
        "args": [
          {
            "name": "Id",
            "label": "Pipeline id"
          },
          {
            "name": "Branch",
            "label": "Branch",
            "default": ""
          }
        ]
      }
    ],
    "handle": {
      "name": "ado",
      "aliases": [
        "azure",
        "devops",
        "workitem",
        "wi"
      ],
      "description": "Azure DevOps: a work item by number, or a search across work items and people",
      "placeholder": "a work item number (12345, AB#12345), or words to search for",
      "resolve": [
        {
          "pattern": "^(?:AB#|#)?([0-9]{3,})$",
          "flags": "i",
          "kind": "work-item",
          "bare": true,
          "label": "Work item #{1}",
          "detail": "Azure DevOps",
          "open": {
            "surface": "ado",
            "target": {
              "workItem": "{1}"
            }
          },
          "mention": "\\bAB#([0-9]{3,})\\b"
        }
      ],
      "search": {
        "route": "/search",
        "minChars": 2,
        "kinds": [
          "work-item",
          "person"
        ]
      },
      "fallback": {
        "surface": "ado",
        "target": {
          "query": "{text}"
        }
      }
    }
  }
}
